# All optional. Lyrics + detection work with none of these set.

# AI "what does this line mean" (free: https://console.groq.com/)
GROQ_API_KEY=

# Audio-fingerprint fallback for players that don't report now-playing info
# (free key: https://acoustid.org/). Also needs fpcalc: `brew install chromaprint`
ACOUSTID_API_KEY=

# Extra plain-text lyrics fallback (https://genius.com/api-clients)
GENIUS_ACCESS_TOKEN=

FLASK_PORT=5000
# macOS fingerprint fallback: name of your loopback input device (brew install blackhole-2ch)
LOOPBACK_DEVICE=BlackHole
